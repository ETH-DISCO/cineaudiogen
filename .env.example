# Copy to .env and `source .env` (or export these in your shell).

# --- LLM provider ---------------------------------------------------------
# Default provider is Gemini (native audio input, recommended):
export GEMINI_API_KEY=your-key-here            # https://aistudio.google.com/apikey

# Or pick another provider for the Director/Critic agents:
# export CINEAUDIOGEN_LLM_PROVIDER=openai            # gpt-4o-audio (listens; <=10 min clips)
# export OPENAI_API_KEY=sk-...
#
# export CINEAUDIOGEN_LLM_PROVIDER=openai-compatible # OpenRouter / vLLM / Ollama / LM Studio
# export CINEAUDIOGEN_LLM_BASE_URL=http://localhost:11434/v1
# export CINEAUDIOGEN_LLM_API_KEY=optional-server-key
# export CINEAUDIOGEN_LLM_AUDIO=on                   # only if the local model can hear (e.g. Qwen2-Audio)
#
# export CINEAUDIOGEN_LLM_PROVIDER=anthropic         # Claude, metrics-only (mixes by the meters)
# export ANTHROPIC_API_KEY=sk-ant-...
#
# export CINEAUDIOGEN_LLM_MODEL=...                  # override the provider's default model

# Optional: where the asset library lives (default: ./data)
# export CINEAUDIOGEN_DATA_ROOT=/path/to/data

# Optional: where generated scenes are written (default: ./output)
# export CINEAUDIOGEN_OUTPUT_DIR=/path/to/output

# Optional: S3-compatible streaming upload (used with `cineaudiogen-batch --s3-bucket ...`).
# Credentials/endpoint come from the standard AWS config (~/.aws/credentials, ~/.aws/config).
# export S3_BUCKET_NAME=my-bucket
# export S3_PREFIX=cinematic_audio_scenes
