# Copy to .env and `source .env` (or export these in your shell).

# Required: Google Gemini API key — https://aistudio.google.com/apikey
export GEMINI_API_KEY=your-key-here

# Optional: where the asset library lives (default: ./data)
# export CINEAUDIOGEN_DATA_ROOT=/path/to/data

# Optional: where generated scenes are written (default: ./output)
# export CINEAUDIOGEN_OUTPUT_DIR=/path/to/output

# Optional: S3-compatible streaming upload (used with `cineaudiogen-batch --s3-bucket ...`).
# Credentials/endpoint come from the standard AWS config (~/.aws/credentials, ~/.aws/config).
# export S3_BUCKET_NAME=my-bucket
# export S3_PREFIX=cinematic_audio_scenes
